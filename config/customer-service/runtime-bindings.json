                     {
                         "lane":  "crm-domain-coordination",
                         "executor":  "proxtel-crm-orchestrator",
                         "preferred_provider":  "task-determined",
                         "fallback":  [

                                      ]
                     }
                 ],
    "tool_policy":  {
                        "reuse_development_registry":  "tools/registry/development-tools.json",
                        "customer_service_specific_tools":  [

                                                            ],

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://proxtel.local/schemas/proxtel-workflow.schema.json",
    "title":  "PROXTEL Workflow Contract",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "kind",
                     "id",
                     "display_name",
                     "area",
                     "version",
                     "status",
                     "provider_neutral",
                     "execution_mode",
                     "purpose",
                     "inputs",
                     "outputs",
                     "states",
                     "steps",
                     "final_decisions",
                     "provider_routing",
                     "safety",
                     "transactionality"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "type":  "string",
                                              "const":  "1.0"
                                          },
                       "kind":  {
                                    "type":  "string",
                                    "const":  "proxtel-workflow"
                                },
                       "id":  {
                                  "type":  "string",
                                  "pattern":  "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                              },
                       "display_name":  {
                                            "type":  "string",
                                            "minLength":  1
                                        },
                       "area":  {
                                    "type":  "string",
                                    "enum":  [
                                                 "core",
                                                 "development",
                                                 "documentation",
                                                 "crm",
                                                 "sales",
                                                 "customer-service",
                                                 "finance",
                                                 "marketing",
                                                 "pbx"
                                             ]
                                },
                       "version":  {
                                       "type":  "string",
                                       "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                                   },
                       "status":  {
                                      "type":  "string",
                                      "enum":  [
                                                   "draft",
                                                   "approved",
                                                   "deprecated"
                                               ]
                                  },
                       "provider_neutral":  {
                                                "type":  "boolean"
                                            },
                       "execution_mode":  {
                                              "type":  "string",
                                              "enum":  [
                                                           "orchestration-only",
                                                           "orchestration-with-tools"
                                                       ]
                                          },
                       "purpose":  {
                                       "type":  "object"
                                   },
                       "inputs":  {
                                      "type":  "array"
                                  },
                       "outputs":  {
                                       "type":  "array"
                                   },
                       "states":  {
                                      "type":  "array",
                                      "minItems":  2
                                  },
                       "steps":  {
                                     "type":  "array",
                                     "minItems":  1
                                 },
                       "final_decisions":  {
                                               "type":  "array",
                                               "minItems":  4
                                           },
                       "provider_routing":  {
                                                "type":  "object"
                                            },
                       "safety":  {
                                      "type":  "object"
                                  },
                       "transactionality":  {
                                                "type":  "object"
                                            }
                   }
}
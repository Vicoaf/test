{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxtel.local/schemas/proxtel-development-tool.schema.json",
  "title": "PROXTEL Development Tool Contract",
  "type": "object",
  "required": [
    "id",
    "area",
    "status",
    "purpose",
    "implementation",
    "capability_lanes",
    "safety",
    "output_contract"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "area": {
      "const": "development"
    },
    "status": {
      "enum": [
        "design-validated",
        "candidate-staged",
        "certified"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "object",
      "required": [
        "language",
        "future_script",
        "execution_mode"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "helper_language": {
          "type": "string"
        },
        "future_script": {
          "type": "string",
          "minLength": 1
        },
        "helper": {
          "type": "string"
        },
        "execution_mode": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "capability_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "optional_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "project_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "supported_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "supported_methods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "connection_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "query_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "output_contract": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}

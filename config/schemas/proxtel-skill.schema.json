{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxtel.local/schemas/proxtel-skill.schema.json",
  "title": "PROXTEL Skill Contract",
  "description": "Canonical machine-readable contract for a PROXTEL Skill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "display_name",
    "area",
    "lifecycle",
    "scope",
    "purpose",
    "capabilities",
    "dependencies",
    "resources",
    "security",
    "compatibility",
    "testing",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "proxtel-skill"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "area": {
      "type": "string",
      "enum": [
        "core",
        "development",
        "documentation",
        "crm",
        "sales",
        "customer-service",
        "finance",
        "marketing",
        "pbx"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "version"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "candidate",
            "under-audit",
            "approved",
            "adapt",
            "reference-only",
            "rejected",
            "deprecated"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "provider_specific",
        "providers"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "core",
            "area",
            "reusable-project",
            "workspace",
            "provider-adapter",
            "customer-specific"
          ]
        },
        "provider_specific": {
          "type": "boolean"
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "use_when",
        "do_not_use_when"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "use_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "do_not_use_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsibilities",
        "limits",
        "completion_criteria"
      ],
      "properties": {
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_md",
        "scripts",
        "references",
        "assets"
      ],
      "properties": {
        "skill_md": {
          "type": "string",
          "const": "SKILL.md"
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "filesystem_write",
        "filesystem_delete",
        "subprocess",
        "environment_access",
        "secret_access",
        "privilege_required"
      ],
      "properties": {
        "network": {
          "$ref": "#/$defs/behavior"
        },
        "filesystem_write": {
          "$ref": "#/$defs/behavior"
        },
        "filesystem_delete": {
          "$ref": "#/$defs/behavior"
        },
        "subprocess": {
          "$ref": "#/$defs/behavior"
        },
        "environment_access": {
          "$ref": "#/$defs/behavior"
        },
        "secret_access": {
          "$ref": "#/$defs/behavior"
        },
        "privilege_required": {
          "type": "boolean"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platforms",
        "providers"
      ],
      "properties": {
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "windows",
              "macos",
              "linux"
            ]
          }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "trigger_tests",
        "task_evals",
        "baseline_comparison"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "trigger_tests": {
          "type": "boolean"
        },
        "task_evals": {
          "type": "boolean"
        },
        "baseline_comparison": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_type",
        "sources"
      ],
      "properties": {
        "origin_type": {
          "type": "string",
          "enum": [
            "proxtel-internal",
            "adapted-external",
            "external-reference",
            "project-specific"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "required",
        "installation_policy"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "runtime",
            "library",
            "cli",
            "mcp",
            "api",
            "browser",
            "service"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version_constraint": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "installation_policy": {
          "type": "string",
          "enum": [
            "explicit",
            "preinstalled",
            "not-applicable"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "purpose"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "description"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "none",
            "read-only",
            "controlled",
            "required"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "internal",
            "github",
            "provider",
            "framework",
            "documentation",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://proxtel.local/schemas/proxtel-agent.schema.json",
    "title":  "PROXTEL Agent Contract",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "kind",
                     "id",
                     "display_name",
                     "area",
                     "version",
                     "status",
                     "provider_neutral",
                     "role",
                     "mission",
                     "scope",
                     "responsibilities",
                     "limits",
                     "skills",
                     "tools",
                     "workflows",
                     "subagents",
                     "provider_routing",
                     "validation",
                     "safety"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "type":  "string",
                                              "const":  "1.0"
                                          },
                       "kind":  {
                                    "type":  "string",
                                    "const":  "proxtel-agent"
                                },
                       "id":  {
                                  "type":  "string",
                                  "pattern":  "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                              },
                       "display_name":  {
                                            "type":  "string",
                                            "minLength":  1
                                        },
                       "area":  {
                                    "type":  "string",
                                    "enum":  [
                                                 "core",
                                                 "development",
                                                 "documentation",
                                                 "crm",
                                                 "sales",
                                                 "customer-service",
                                                 "finance",
                                                 "marketing",
                                                 "pbx"
                                             ]
                                },
                       "version":  {
                                       "type":  "string",
                                       "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                                   },
                       "status":  {
                                      "type":  "string",
                                      "enum":  [
                                                   "draft",
                                                   "approved",
                                                   "deprecated"
                                               ]
                                  },
                       "provider_neutral":  {
                                                "type":  "boolean"
                                            },
                       "role":  {
                                    "type":  "string",
                                    "minLength":  1
                                },
                       "mission":  {
                                       "type":  "string",
                                       "minLength":  1
                                   },
                       "scope":  {
                                     "type":  "object"
                                 },
                       "responsibilities":  {
                                                "type":  "array",
                                                "minItems":  1
                                            },
                       "limits":  {
                                      "type":  "object"
                                  },
                       "skills":  {
                                      "type":  "object"
                                  },
                       "tools":  {
                                     "type":  "object"
                                 },
                       "workflows":  {
                                         "type":  "array",
                                         "minItems":  1
                                     },
                       "subagents":  {
                                         "type":  "array"
                                     },
                       "provider_routing":  {
                                                "type":  "object"
                                            },
                       "validation":  {
                                          "type":  "object"
                                      },
                       "safety":  {
                                      "type":  "object"
                                  }
                   }
}
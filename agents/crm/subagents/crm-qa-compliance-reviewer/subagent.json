{
    "schema_version":  "1.0",
    "kind":  "proxtel-subagent",
    "id":  "crm-qa-compliance-reviewer",
    "display_name":  "CRM QA and Compliance Reviewer",
    "area":  "crm",
    "version":  "1.0.0",
    "status":  "approved",
    "provider_neutral":  true,
    "parent_agent":  "proxtel-crm-orchestrator",
    "preferred_provider":  "antigravity",
    "persistent":  false,
    "mission":  "Independently verify CRM-domain behavior, permissions, auditability, import safety, workflow correctness and release evidence.",
    "scope":  [
                  "permission validation",
                  "auditability",
                  "import safety",
                  "workflow validation",
                  "release-domain review"
              ],
    "limits":  {
                   "repository_code_implementation":  false,
                   "production_mutation":  false,
                   "database_mutation":  false,
                   "automatic_git_operations":  false,
                   "automatic_external_side_effects":  false,
                   "secret_export":  false
               },
    "handoff":  {
                    "implementation_target":  "proxtel-development-orchestrator",
                    "must_return_evidence":  true,
                    "must_report_assumptions":  true
                }
}

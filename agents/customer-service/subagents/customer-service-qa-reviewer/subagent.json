{
    "schema_version":  "1.0",
    "kind":  "proxtel-subagent",
    "id":  "customer-service-qa-reviewer",
    "display_name":  "Customer Service QA Reviewer",
    "area":  "customer-service",
    "version":  "1.0.0",
    "status":  "approved",
    "provider_neutral":  true,
    "parent_agent":  "proxtel-customer-service-orchestrator",
    "persistent":  false,
    "mission":  "Independently verify ticket behavior, permissions, SLA/escalation logic, communication quality, auditability and release evidence.",

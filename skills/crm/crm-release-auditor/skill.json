{
    "schema_version":  "1.0",
    "kind":  "proxtel-skill",
    "id":  "crm-release-auditor",
    "display_name":  "CRM Release Auditor",
    "area":  "crm",
    "version":  "1.0.0",
    "status":  "approved",
    "provider_neutral":  true,
    "description":  "Perform independent CRM-domain release review covering permissions, audit history, data safety, workflow correctness and known limitations.",
    "scope":  {
                  "use_when":  [
                                   "CRM change approaches release",
                                   "permission-sensitive behavior changed",
                                   "imports/integrations/workflows changed materially"
                               ],
                  "do_not_use_for":  [
                                         "direct production deployment",
                                         "destructive production database operations",
                                         "bypassing Development implementation governance"
                                     ]
              },
    "dependencies":  {
                         "direct_scripts":  [

                                            ],
                         "direct_packages":  [

                                             ],
                         "silent_installation_allowed":  false
                     },
    "safety":  {
                   "read_only_discovery_first":  true,
                   "local_first":  true,
                   "pii_minimization":  true,
                   "secrets_in_output_forbidden":  true,
                   "production_mutation_default":  false,
                   "database_mutation_default":  false,
                   "automatic_git_operations":  false,
                   "automatic_live_retry":  false
               },
    "outputs":  [
                    "release decision",
                    "blocking issues",
                    "permission findings",
                    "data/workflow findings",
                    "known limitations"
                ],
    "lifecycle":  {
                      "current":  "approved",
                      "certification_required_before_activation":  true,
                      "global_registry_promotion":  "area-local-activation",
                      "activation_scope":  "crm-area-local"
                  }
}

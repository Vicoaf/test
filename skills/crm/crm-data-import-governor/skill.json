{
    "schema_version":  "1.0",
    "kind":  "proxtel-skill",
    "id":  "crm-data-import-governor",
    "display_name":  "CRM Data Import Governor",
    "area":  "crm",
    "version":  "1.0.0",
    "status":  "approved",
    "provider_neutral":  true,
    "description":  "Define safe CRM import mappings, duplicate rules, validation, dry-run expectations and PII handling without mutating production data.",
    "scope":  {
                  "use_when":  [
                                   "CSV/XLS import is requested",
                                   "deduplication rules are needed",
                                   "migration/import safety must be reviewed"
                               ],
                  "do_not_use_for":  [
                                         "direct production deployment",
                                         "destructive production database operations",
                                         "bypassing Development implementation governance"
                                     ]
              },
    "dependencies":  {
                         "direct_scripts":  [

                                            ],
                         "direct_packages":  [

                                             ],
                         "silent_installation_allowed":  false
                     },
    "safety":  {
                   "read_only_discovery_first":  true,
                   "local_first":  true,
                   "pii_minimization":  true,
                   "secrets_in_output_forbidden":  true,
                   "production_mutation_default":  false,
                   "database_mutation_default":  false,
                   "automatic_git_operations":  false,
                   "automatic_live_retry":  false
               },
    "outputs":  [
                    "field mapping",
                    "validation rules",
                    "duplicate policy",
                    "reject/error policy",
                    "dry-run acceptance criteria"
                ],
    "lifecycle":  {
                      "current":  "approved",
                      "certification_required_before_activation":  true,
                      "global_registry_promotion":  "area-local-activation",
                      "activation_scope":  "crm-area-local"
                  }
}

{
    "schema_version":  "1.0",
    "kind":  "proxtel-skill",
    "id":  "proxtel-skill-creator",
    "display_name":  "PROXTEL Skill Creator",
    "area":  "core",
    "lifecycle":  {
                      "state":  "approved",
                      "version":  "0.1.0"
                  },
    "scope":  {
                  "level":  "core",
                  "provider_specific":  false,
                  "providers":  [
                                    "claude",
                                    "codex",
                                    "antigravity"
                                ]
              },
    "purpose":  {
                    "summary":  "Design and assemble auditable PROXTEL Skill candidates after first routing the requirement to the correct customization mechanism.",
                    "use_when":  [
                                     "Creating a new reusable PROXTEL Skill.",
                                     "Improving an existing Skill while preserving its review boundary.",
                                     "Deciding whether a requirement belongs in a Skill or another mechanism.",
                                     "Preparing a Skill candidate and evidence package for proxtel-skill-auditor."
                                 ],
                    "do_not_use_when":  [
                                            "Issuing the final APPROVED decision for a Skill.",
                                            "Installing dependencies silently.",
                                            "Executing unaudited external code.",
                                            "Changing production as the first test.",
                                            "Implementing a capability that Mechanism Router classifies as another mechanism."
                                        ]
                },
    "capabilities":  {
                         "responsibilities":  [
                                                  "Capture structured creation intake.",
                                                  "Route the requirement across Skill, Rule, Workflow, Agent, Subagent, Tool, MCP, Adapter, Hook, Plugin or project configuration.",
                                                  "Classify the narrowest appropriate scope.",
                                                  "Design provider-neutral Skill contracts and operating instructions.",
                                                  "Use progressive disclosure for references, scripts and assets.",
                                                  "Declare dependencies and security behavior explicitly.",
                                                  "Prepare deterministic tests and evaluation inputs.",
                                                  "Produce candidate lifecycle output only.",
                                                  "Prepare a complete handoff to proxtel-skill-auditor."
                                              ],
                         "limits":  [
                                        "Cannot self-approve a Skill.",
                                        "Cannot hide dependencies or secrets.",
                                        "Cannot execute unaudited upstream code.",
                                        "Cannot silently replace an existing Skill.",
                                        "Cannot assume a dependency or tool is installed.",
                                        "Cannot use production as the first test environment."
                                    ],
                         "completion_criteria":  [
                                                     "Mechanism and scope decisions are explicit.",
                                                     "Candidate satisfies the canonical PROXTEL Skill contract.",
                                                     "Dependencies, resources and security declarations are explicit.",
                                                     "Applicable tests are prepared.",
                                                     "Candidate lifecycle state remains candidate.",
                                                     "Auditor handoff contains enough evidence for independent review."
                                                 ]
                     },

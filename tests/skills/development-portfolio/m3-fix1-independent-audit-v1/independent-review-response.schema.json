{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "portfolio_decision",
    "promotion_eligible",
    "blocking_issue_count",
    "portfolio_reasons",
    "required_actions",
    "skills"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "const": "PROXTEL-AREA-1.7-M3-FIX1-DEVELOPMENT-PORTFOLIO-INDEPENDENT-AUDIT-V1"
    },
    "portfolio_decision": {
      "type": "string",
      "enum": ["APPROVED","ADAPT","REFERENCE-ONLY","REJECTED"]
    },
    "promotion_eligible": {
      "type": "boolean"
    },
    "blocking_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "portfolio_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "promotion_eligible",
          "blocking_issues",
          "reasons",
          "strengths",
          "risks",
          "required_actions",
          "gates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["auditor-web","estratega-seo","maestro-frontend"]
          },
          "decision": {
            "type": "string",
            "enum": ["APPROVED","ADAPT","REFERENCE-ONLY","REJECTED"]
          },
          "promotion_eligible": {
            "type": "boolean"
          },
          "blocking_issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "strengths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity",
              "integrity",
              "license",
              "static_security",
              "dependencies",
              "semantic",
              "safe_to_execute",
              "sandbox",
              "evaluation",
              "baseline",
              "holdout",
              "independent_review"
            ],
            "properties": {
              "identity": {"$ref":"#/$defs/gateStatus"},
              "integrity": {"$ref":"#/$defs/gateStatus"},
              "license": {"$ref":"#/$defs/gateStatus"},
              "static_security": {"$ref":"#/$defs/gateStatus"},
              "dependencies": {"$ref":"#/$defs/gateStatus"},
              "semantic": {"$ref":"#/$defs/gateStatus"},
              "safe_to_execute": {"$ref":"#/$defs/gateStatus"},
              "sandbox": {"$ref":"#/$defs/gateStatus"},
              "evaluation": {"$ref":"#/$defs/gateStatus"},
              "baseline": {"$ref":"#/$defs/gateStatus"},
              "holdout": {"$ref":"#/$defs/gateStatus"},
              "independent_review": {"$ref":"#/$defs/gateStatus"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "gateStatus": {
      "type": "string",
      "enum": ["NOT-APPLICABLE","PASS","WARN","FAIL","CRITICAL"]
    }
  }
}
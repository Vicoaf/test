                    "summary":  "Audit internal or external Skills using evidence-driven gates before a final decision.",
                    "use_when":  [
                                     "Auditing a new internal Skill.",
                                     "Auditing an external Skill in quarantine.",
                                     "Reviewing a candidate Skill update.",
                                     "Producing evidence for APPROVED, ADAPT, REFERENCE-ONLY or REJECTED."
                                 ],
                    "do_not_use_when":  [
                                            "Creating a new Skill from scratch.",
                                            "Silently modifying the audited Skill.",
                                            "Executing unaudited upstream code.",
                                            "Testing directly in production."
                                        ]
                },
    "capabilities":  {
                         "responsibilities":  [
                                                  "Audit identity and provenance.",
                                                  "Verify integrity and licensing.",
                                                  "Assess static security and dependencies.",

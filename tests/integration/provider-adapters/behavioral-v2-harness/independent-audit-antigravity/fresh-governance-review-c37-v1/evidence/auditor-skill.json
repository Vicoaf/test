                                                  "Control safe-to-execute decisions.",
                                                  "Evaluate candidate Skills against applicable evidence and baselines.",
                                                  "Produce an evidence-backed final decision."
                                              ],
                         "limits":  [
                                        "Does not self-approve created Skills without independent evidence.",
                                        "Does not execute unaudited external code.",
                                        "Does not install dependencies silently.",
                                        "Does not use production as the first test environment."
                                    ],
                         "completion_criteria":  [
                                                     "Applicable audit stages are explicitly classified.",
                                                     "Material findings contain evidence.",
                                                     "Unknowns remain explicitly identified.",
                                                     "Final decision uses only allowed decision states."
